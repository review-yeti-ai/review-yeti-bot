{
  "schema": "exampleorg.review-policy.v1",
  "review_yeti": {
    "repository": "review-yeti-ai/review-yeti-bot",
    "action_channel": "v1",
    "action_channel_pattern": "^v[0-9]+(\\.[0-9]+){0,2}$",
    "personas": "security,performance,architecture,testing,dependencies,licensing",
    "dispatch_mode": "striped",
    "transports": [
      {
        "name": "openrouter-primary",
        "enabled": true,
        "base_url": "https://openrouter.ai/api/v1",
        "api_key_env": "OPENROUTER_PR_REVIEW_API_KEY",
        "model": "deepseek/deepseek-v4-flash-0731",
        "models": ["z-ai/glm-5.3-flash"],
        "compat": "openrouter",
        "timeout_ms": 90000,
        "connect_timeout_ms": 20000,
        "ttft_ms": 75000,
        "stall_ms": 30000,
        "max_tokens": 24576,
        "stream": true,
        "dispatch_weight": 2,
        "max_in_flight": 2,
        "concurrency_scope": "provider",
        "capacity_wait_timeout_ms": 180000,
        "rate_limit": {
          "scope": "provider",
          "max_retries": 1,
          "max_retry_after_ms": 5000
        },
        "structured_output": "strict",
        "quarantine_on_timeout": false,
        "ignore_providers": ["morph", "fireworks"],
        "provider_routing": {
          "allow_fallbacks": true,
          "require_parameters": true,
          "ignore": ["morph", "fireworks"],
          "sort": "throughput",
          "preferred_min_throughput": {
            "p90": 40
          },
          "preferred_max_latency": {
            "p99": 3
          },
          "data_collection": "deny"
        },
        "reasoning_effort": "high"
      },
      {
        "name": "gemini",
        "enabled": false,
        "base_url": "https://generativelanguage.googleapis.com/v1beta/openai",
        "api_key_env": "GEMINI_API_KEY",
        "model": "gemini-3.7-flash",
        "compat": "openai",
        "timeout_ms": 90000,
        "connect_timeout_ms": 15000,
        "ttft_ms": 60000,
        "stall_ms": 20000,
        "max_tokens": 24576,
        "stream": true,
        "dispatch_weight": 1,
        "max_in_flight": 1,
        "concurrency_scope": "provider",
        "capacity_wait_timeout_ms": 30000,
        "rate_limit": {
          "scope": "provider",
          "max_retries": 1,
          "max_retry_after_ms": 5000
        },
        "structured_output": "strict",
        "reasoning_effort": "high"
      },
      {
        "name": "ollama",
        "enabled": false,
        "base_url": "https://ollama.com/v1",
        "api_key_env": "OLLAMA_PR_REVIEW_API_KEY",
        "model": "deepseek-v4-flash:cloud",
        "compat": "openai",
        "timeout_ms": 90000,
        "connect_timeout_ms": 20000,
        "ttft_ms": 60000,
        "stall_ms": 20000,
        "max_tokens": 24576,
        "stream": true,
        "dispatch_weight": 1,
        "max_in_flight": 1,
        "concurrency_scope": "provider",
        "capacity_wait_timeout_ms": 30000,
        "rate_limit": {
          "scope": "provider",
          "max_retries": 1,
          "max_retry_after_ms": 5000
        },
        "reasoning_effort": "high",
        "quarantine_on_timeout": false
      },
      {
        "name": "synthetic",
        "enabled": true,
        "base_url": "https://api.synthetic.new/openai/v1",
        "api_key_env": "SYNTHETIC_API_KEY",
        "model": "hf:zai-org/GLM-5.3-Flash",
        "compat": "openai",
        "timeout_ms": 120000,
        "connect_timeout_ms": 15000,
        "ttft_ms": 60000,
        "stall_ms": 20000,
        "max_tokens": 24576,
        "stream": true,
        "dispatch_weight": 1,
        "max_in_flight": 5,
        "concurrency_scope": "model",
        "capacity_wait_timeout_ms": 120000,
        "quota_probe": "synthetic-v2",
        "rate_limit": {
          "scope": "provider",
          "max_retries": 1,
          "max_retry_after_ms": 5000
        },
        "structured_output": "strict",
        "quarantine_on_timeout": false,
        "reasoning_effort": "high"
      },
      {
        "name": "fireworks",
        "enabled": false,
        "base_url": "https://api.fireworks.ai/inference/v1",
        "api_key_env": "FIREWORKS_PR_REVIEW_API_KEY",
        "model": "accounts/fireworks/models/deepseek-v4-flash-0731",
        "compat": "openai",
        "timeout_ms": 120000,
        "connect_timeout_ms": 15000,
        "ttft_ms": 60000,
        "stall_ms": 20000,
        "max_tokens": 24576,
        "stream": true,
        "dispatch_weight": 1,
        "max_in_flight": 1,
        "concurrency_scope": "provider",
        "capacity_wait_timeout_ms": 30000,
        "rate_limit": {
          "scope": "provider",
          "max_retries": 1,
          "max_retry_after_ms": 5000
        },
        "structured_output": "strict",
        "perf_metrics_in_response": true,
        "reasoning_effort": "high"
      }
    ],
    "openrouter_stream": "true",
    "openrouter_timeout_ms": "90000",
    "openrouter_ttft_ms": "75000",
    "openrouter_max_attempts": "2",
    "stall_ms": "30000",
    "budget": {
      "lane_deadline_ms": "860000",
      "lane_overhead_ms": "120000",
      "lane_call_budget": "24",
      "max_review_assignments": "24",
      "max_investigation_turns": "2"
    },
    "max_diff_chars": "2000000",
    "max_incremental_diff_chars": "60000",
    "max_file_diff_chars": "60000",
    "max_passes": "1",
    "exclude": "docs/api/autogenerated/**,priv/repo/structure.sql,apm.lock.yaml,.apm/**"
  },
  "repository_overrides": {
    "exampleorg/example-api": {
      "dispatch_mode": "ordered",
      "enabled_transports": ["ollama"]
    }
  },
  "forbidden_target_paths": [
    ".review-yeti.yaml",
    ".review-yeti.yml",
    ".ct-review.yaml",
    ".ct-review.yml",
    ".review-yeti",
    ".ct-review"
  ]
}
