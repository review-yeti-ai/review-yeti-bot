{
  "schema": "exampleorg.review-policy.v1",
  "review_yeti": {
    "repository": "review-yeti-ai/review-yeti-bot",
    "action_channel": "v1",
    "action_channel_pattern": "^v[0-9]+(\\.[0-9]+){0,2}$",
    "personas": "architecture,security,documentation",
    "review_engine": "dsh",
    "dispatch_mode": "ordered",
    "mcp_servers": [
      {
        "id": "ct-impact",
        "name": "exampleorg AST Code Mesh & Blast Radius",
        "transport": "stdio",
        "command": "node",
        "args": [
          ".exampleorg-review-actions/scripts/ct-impact-mcp.mjs"
        ],
        "enabled": true
      },
      {
        "id": "review-arbiter",
        "name": "Review Output Arbiter (structured-contract normalizer)",
        "transport": "stdio",
        "command": "node",
        "args": [
          ".exampleorg-review-actions/scripts/arbiter-mcp.mjs"
        ],
        "enabled": true
      },
      {
        "id": "honcho-memory",
        "name": "Honcho Operational Memory",
        "transport": "stdio",
        "command": "node",
        "args": [
          ".exampleorg-review-actions/scripts/honcho-mcp.mjs"
        ],
        "enabled": true
      }
    ],
    "transports": [
      {
        "name": "bifrost",
        "enabled": true,
        "base_url": "https://gateway-internal.example.com/v1",
        "api_key_env": "BIFROST_PR_REVIEW_API_KEY",
        "model": "pr-reviewer",
        "compat": "openai",
        "max_tokens": 65536,
        "timeout_ms": 90000,
        "connect_timeout_ms": 90000,
        "ttft_ms": 60000,
        "stall_ms": 30000,
        "max_wall_clock_ms": 900000,
        "stream": true,
        "dispatch_weight": 1,
        "max_in_flight": 4,
        "concurrency_scope": "provider",
        "capacity_wait_timeout_ms": 30000,
        "rate_limit": {
          "scope": "provider",
          "max_retries": 1,
          "max_retry_after_ms": 5000
        },
        "reasoning_effort": "medium",
        "quarantine_on_timeout": false,
        "structured_output": "strict"
      },
      {
        "name": "openrouter-primary",
        "enabled": false,
        "base_url": "https://openrouter.ai/api/v1",
        "api_key_env": "OPENROUTER_PR_REVIEW_API_KEY",
        "model": "z-ai/glm-5.3-flash",
        "models": [],
        "compat": "openrouter",
        "timeout_ms": 90000,
        "connect_timeout_ms": 20000,
        "ttft_ms": 75000,
        "stall_ms": 30000,
        "stream": true,
        "dispatch_weight": 2,
        "max_in_flight": 2,
        "concurrency_scope": "provider",
        "capacity_wait_timeout_ms": 180000,
        "rate_limit": {
          "scope": "provider",
          "max_retries": 1,
          "max_retry_after_ms": 5000
        },
        "structured_output": "strict",
        "quarantine_on_timeout": false,
        "ignore_providers": [
          "morph",
          "fireworks"
        ],
        "provider_routing": {
          "allow_fallbacks": true,
          "require_parameters": true,
          "ignore": [
            "morph",
            "fireworks"
          ],
          "sort": "throughput",
          "preferred_min_throughput": {
            "p90": 40
          },
          "preferred_max_latency": {
            "p99": 3
          },
          "data_collection": "deny"
        },
        "reasoning_effort": "high"
      },
      {
        "name": "gemini",
        "enabled": false,
        "base_url": "https://generativelanguage.googleapis.com/v1beta/openai",
        "api_key_env": "GEMINI_API_KEY",
        "model": "gemini-3.7-flash",
        "compat": "openai",
        "timeout_ms": 90000,
        "connect_timeout_ms": 15000,
        "ttft_ms": 60000,
        "stall_ms": 20000,
        "stream": true,
        "dispatch_weight": 1,
        "max_in_flight": 1,
        "concurrency_scope": "provider",
        "capacity_wait_timeout_ms": 30000,
        "rate_limit": {
          "scope": "provider",
          "max_retries": 1,
          "max_retry_after_ms": 5000
        },
        "structured_output": "strict",
        "reasoning_effort": "high"
      },
      {
        "name": "ollama",
        "enabled": false,
        "base_url": "https://ollama.com/v1",
        "api_key_env": "OLLAMA_PR_REVIEW_API_KEY",
        "model": "glm-5.3-flash",
        "compat": "openai",
        "max_tokens": 65536,
        "timeout_ms": 90000,
        "connect_timeout_ms": 90000,
        "ttft_ms": 60000,
        "stall_ms": 90000,
        "max_wall_clock_ms": 900000,
        "stream": true,
        "dispatch_weight": 1,
        "max_in_flight": 6,
        "concurrency_scope": "provider",
        "capacity_wait_timeout_ms": 30000,
        "rate_limit": {
          "scope": "provider",
          "max_retries": 1,
          "max_retry_after_ms": 5000
        },
        "reasoning_effort": "none",
        "quarantine_on_timeout": false
      }
    ],
    "openrouter_stream": "true",
    "openrouter_timeout_ms": "90000",
    "openrouter_ttft_ms": "75000",
    "openrouter_max_attempts": "2",
    "stall_ms": "30000",
    "budget": {
      "lane_deadline_ms": 1080000,
      "lane_overhead_ms": "120000",
      "lane_call_budget": "24",
      "max_review_assignments": "24",
      "max_investigation_turns": 15
    },
    "max_diff_chars": "2000000",
    "max_incremental_diff_chars": "60000",
    "max_file_diff_chars": "524288",
    "max_passes": "1",
    "exclude": "docs/api/autogenerated/**,priv/repo/structure.sql,apm.lock.yaml,.apm/**,package-lock.json,Cargo.lock,poetry.lock,composer.lock,yarn.lock,pnpm-lock.yaml,.yarn/**,.pnpm/**",
    "telemetry": {
      "metrics_endpoint": "http://otel-collector.observability.svc.cluster.local:4318/v1/metrics",
      "scrape_port": 3000
    },
    "retry_analysis": {
      "track_failure_classes": true,
      "max_retries": 2
    }
  },
  "forbidden_target_paths": [
    ".review-yeti.yaml",
    ".review-yeti.yml",
    ".ct-review.yaml",
    ".ct-review.yml",
    ".review-yeti",
    ".ct-review"
  ]
}
