{
  "schema": "exampleorg.review-policy.v1",
  "review_yeti": {
    "repository": "review-yeti-ai/review-yeti-bot",
    "action_sha": "762974cfa8bf2fabf80699c29c912d0a5451bd94",
    "personas": "security,performance,architecture,testing,dependencies",
    "transports": [
      {
        "name": "fireworks",
        "base_url": "https://api.fireworks.ai/inference/v1",
        "api_key_env": "FIREWORKS_PR_REVIEW_API_KEY",
        "model": "accounts/fireworks/models/deepseek-v4-flash-0731",
        "compat": "openai",
        "timeout_ms": 180000,
        "connect_timeout_ms": 60000,
        "structured_output": "strict"
      },
      {
        "name": "ollama",
        "base_url": "https://ollama.com/v1",
        "api_key_env": "OLLAMA_PR_REVIEW_API_KEY",
        "model": "deepseek-v4-flash:0731",
        "compat": "openai",
        "timeout_ms": 180000,
        "connect_timeout_ms": 60000,
        "structured_output": "strict"
      },
      {
        "name": "openrouter-fallback",
        "base_url": "https://openrouter.ai/api/v1",
        "api_key_env": "OPENROUTER_PR_REVIEW_API_KEY",
        "model": "deepseek/deepseek-v4-flash-0731",
        "compat": "openrouter",
        "timeout_ms": 180000,
        "connect_timeout_ms": 60000,
        "structured_output": "strict",
        "provider_routing": {
          "allow_fallbacks": true,
          "data_collection": "deny"
        }
      }
    ],
    "openrouter_stream": "true",
    "openrouter_timeout_ms": "180000",
    "openrouter_ttft_ms": "60000",
    "openrouter_max_attempts": "2",
    "lane_deadline_ms": "600000",
    "max_investigation_turns": "3",
    "max_diff_chars": "2000000",
    "max_file_diff_chars": "60000",
    "max_passes": "3",
    "exclude": "docs/api/autogenerated/**,priv/repo/structure.sql,apm.lock.yaml,.apm/**"
  },
  "forbidden_target_paths": [
    ".review-yeti.yaml",
    ".review-yeti.yml",
    ".ct-review.yaml",
    ".ct-review.yml",
    ".review-yeti",
    ".ct-review"
  ]
}
