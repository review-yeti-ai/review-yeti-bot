{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://review-yeti.ai/schemas/review-yeti-event.v2.schema.json",
  "title": "Review Yeti Lifecycle Event Envelope v2",
  "description": "Closed, sanitized Review Yeti lifecycle-only event envelope with a PR-wide position.",
  "$comment": "Maintenance contract: update this language-neutral schema and src/events/reviewYetiEventV2.ts together; tests/unit/reviewYetiEventV2.test.ts is the executable semantic parity gate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "event_id",
    "event_kind",
    "occurred_at",
    "repository_id",
    "pr_number",
    "base_sha",
    "head_sha",
    "attempt_id",
    "run_id",
    "sequence",
    "sequence_domain",
    "correlation_id",
    "trace_id",
    "visibility",
    "data"
  ],
  "properties": {
    "schema": { "const": "review-yeti-event.v2" },
    "event_id": { "type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$" },
    "event_kind": {
      "type": "string",
      "pattern": "^review\\.lifecycle\\.(?!v\\d(?:\\.|$))[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "occurred_at": { "type": "string", "format": "date-time" },
    "repository_id": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "pr_number": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "base_sha": { "type": "string", "pattern": "^[a-fA-F0-9]{40}$" },
    "head_sha": { "type": "string", "pattern": "^[a-fA-F0-9]{40}$" },
    "attempt_id": { "$ref": "#/$defs/identifier" },
    "run_id": { "$ref": "#/$defs/identifier" },
    "sequence": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 },
    "sequence_domain": { "const": "pr_lifecycle_v2" },
    "correlation_id": { "$ref": "#/$defs/identifier" },
    "trace_id": { "$ref": "#/$defs/identifier" },
    "visibility": { "const": "internal" },
    "data": { "$ref": "#/$defs/lifecycleData" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f\\s]+$"
    },
    "digest": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "queued_at": { "$ref": "#/$defs/timestamp" },
        "started_at": { "$ref": "#/$defs/timestamp" },
        "completed_at": { "$ref": "#/$defs/timestamp" },
        "duration_ms": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      }
    },
    "lifecycleData": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stage": { "$ref": "#/$defs/label128" },
        "terminal_class": { "$ref": "#/$defs/label128" },
        "result_digest": { "$ref": "#/$defs/digest" },
        "policy_digest": { "$ref": "#/$defs/digest" },
        "duration_ms": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "retry_class": { "$ref": "#/$defs/label128" },
        "evidence_pointers": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/identifier512" } },
        "timing": { "$ref": "#/$defs/timing" }
      }
    },
    "label128": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f\\s]+$"
    },
    "identifier512": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000-\\u001f\\u007f\\s]+$"
    }
  }
}
