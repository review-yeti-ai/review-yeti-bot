{
  "name": "ct-review-bot",
  "version": "1.32.3",
  "description": "Repository-configurable persona-panel GitHub App with binding arbitration",
  "main": "dist/index.js",
  "bin": {
    "review-yeti": "bin/review-yeti.js",
    "git-yeti": "bin/review-yeti.js",
    "ct-review": "bin/review-yeti.js"
  },
  "files": [
    "action.yml",
    ".github/workflows/pipelines/",
    "src/",
    "dist/",
    "bin/",
    "scripts/",
    "pi-runtime/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "generate:providers": "ts-node scripts/generate-omniroute-providers.ts",
    "build:frontend": "node scripts/clean-frontend.js && next build && node scripts/postbuild.js",
    "build:backend": "tsc -p tsconfig.server.json",
    "build": "npm run build:frontend && npm run build:backend",
    "start": "node dist/index.js",
    "start:dispatch": "node dist/dispatchIndex.js",
    "start:review-job-dispatcher": "node dist/reviewJobDispatcherIndex.js",
    "dev": "ts-node src/index.ts",
    "pretest": "npm run test:artifacts",
    "test": "vitest run",
    "test:changed": "vitest run --changed=main",
    "test:frontend": "vitest run tests/unit/appStaticServ.test.ts tests/unit/dashboard*.test.ts tests/integration/dashboard*.test.ts",
    "test:backend": "vitest run tests/unit/panel*.test.ts tests/unit/summary*.test.ts tests/unit/provider*.test.ts tests/unit/graph*.test.ts tests/unit/indexer*.test.ts",
    "test:components": "vitest run tests/unit/**/*.test.tsx",
    "test:unit": "vitest run tests/unit",
    "test:release-contract": "vitest run --config vitest.release.config.ts",
    "test:integration": "vitest run tests/integration",
    "test:generational": "vitest run tests/unit/reviewCoreDifferential.test.ts tests/unit/reviewGenerationContracts.test.ts tests/unit/reviewAdmission.test.ts tests/unit/piRunState.test.ts tests/unit/actionPolicyContract.test.ts",
    "test:e2e": "vitest run tests/e2e",
    "test:replay": "vitest run tests/unit/cassetteReplay.test.ts tests/unit/openRouterClient.test.ts tests/integration/reviewReplay.test.ts tests/integration/openRouterFleetReplay.test.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:release-version": "vitest run tests/unit/releaseVersion.test.ts",
    "test:release-workflows": "vitest run tests/unit/releaseWorkflowConfig.test.ts tests/unit/releaseWorkflowContract.test.ts",
    "benchmark:release": "node scripts/evaluate-release-benchmark.mjs",
    "benchmark:compare": "node scripts/compare-release-baselines.mjs",
    "prepack": "node scripts/stage-publish-package.mjs --prepare-current",
    "postpack": "node scripts/stage-publish-package.mjs --clean-current",
    "lint": "npm run lint:src && npm run lint:tests",
    "lint:src": "tsc --noEmit",
    "lint:tests": "node scripts/check-test-files-parse.mjs",
    "clean": "rm -rf dist",
    "clean:frontend": "node scripts/clean-frontend.js",
    "pretest:unit": "npm run test:artifacts",
    "pretest:integration": "npm run test:artifacts",
    "pretest:e2e": "npm run test:artifacts",
    "pretest:replay": "npm run test:artifacts",
    "pretest:changed": "npm run test:artifacts",
    "test:artifacts": "node scripts/ensure-static-assets.js && node scripts/ensure-pipeline-build.js && npm run domains:check",
    "domains:build": "ts-node scripts/build-domain-index.ts",
    "domains:check": "ts-node scripts/build-domain-index.ts --check",
    "pretest:release-contract": "npm run test:artifacts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@earendil-works/pi-tui": "0.84.1",
    "@kubernetes/client-node": "^1.4.0",
    "@octokit/core": "^6.1.2",
    "@openrouter/sdk": "1.2.80",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/resources": "^1.25.0",
    "@opentelemetry/sdk-metrics": "^1.25.0",
    "@opentelemetry/sdk-trace-base": "^1.25.0",
    "@opentelemetry/semantic-conventions": "^1.25.0",
    "@quintinshaw/pi-dynamic-workflows": "3.7.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@xyflow/react": "^12.11.2",
    "autoprefixer": "^10.5.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^4.19.2",
    "jose": "5.10.0",
    "js-yaml": "^4.1.0",
    "lucide-react": "^1.27.0",
    "next": "^14.2.35",
    "pg": "^8.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typebox": "1.3.7",
    "typescript": "^5.4.5",
    "undici": "7.29.0",
    "zod": "^3.23.8"
  },
  "bundledDependencies": [
    "@quintinshaw/pi-dynamic-workflows",
    "@earendil-works/pi-ai",
    "@earendil-works/pi-coding-agent",
    "@earendil-works/pi-tui",
    "typebox"
  ],
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.18.1",
    "@vercel/nft": "1.11.0",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "bundleDependencies": [
    "@quintinshaw/pi-dynamic-workflows",
    "@earendil-works/pi-ai",
    "@earendil-works/pi-coding-agent",
    "@earendil-works/pi-tui",
    "typebox"
  ]
}
