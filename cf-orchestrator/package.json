{
  "name": "@review-yeti-ai/cf-orchestrator",
  "version": "1.0.0",
  "description": "Cloudflare-native serverless orchestration engine for Review Yeti",
  "main": "dist/src/worker.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "node --import ./test/register-cf.js --test \"dist/**/*.test.js\"",
    "test:unit": "node --import ./test/register-cf.js --test \"dist/test/*.test.js\"",
    "test:e2e": "node --import ./test/register-cf.js --test \"dist/test/e2e/*.e2e.test.js\"",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "keywords": [
    "review-yeti",
    "cloudflare-workers",
    "durable-objects",
    "workflows"
  ],
  "author": "Review Yeti",
  "license": "Apache-2.0",
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "@types/node": "^26.6.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
