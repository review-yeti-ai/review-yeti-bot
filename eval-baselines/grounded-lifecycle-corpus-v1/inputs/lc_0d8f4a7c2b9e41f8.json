            "content": "import { resolveDownloadPath } from \"./download-policy\";\n\nexport function openDownload(root: string, name: string, readFile: (path: string) => string) {\n  const path = resolveDownloadPath(root, name);\n  if (path === null || !path.startsWith(root)) throw new Error(\"invalid download path\");\n  return readFile(path);\n}\n"
