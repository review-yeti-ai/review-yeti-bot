            "content": "import { relative, resolve, sep, isAbsolute } from \"node:path\";\n\nexport function resolveDownloadPath(root: string, requested: string): string | null {\n  const rootPath = resolve(root);\n  const resolved = resolve(rootPath, requested);\n  const relativePath = relative(rootPath, resolved);\n  if (relativePath === \"\" || relativePath === \"..\" || relativePath.startsWith(`..${sep}`) || isAbsolute(relativePath)) return null;\n  return resolved;\n}\n"
