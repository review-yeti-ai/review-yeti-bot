diff --git a/sip_signaling_service/src/sipStateMachine.ts b/sip_signaling_service/src/sipStateMachine.ts
@@ -75,14 +75,21 @@ export class SipStateMachine {
+  public generateBranchId(): string {
+    // RFC 3261 Section 8.1.1.7: Magic cookie prefix z9hG4bK
