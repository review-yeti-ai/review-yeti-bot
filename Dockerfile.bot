FROM node:24-bookworm-slim AS runner

WORKDIR /app

# REL-1080: the trusted completion side computes the git-derived diff for pull
# requests GitHub refuses to render (HTTP 406). Same Debian release line as the
# worker image (bookworm git 2.39), so both sides produce the same diff.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates git \
 && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production
ENV UV_THREADPOOL_SIZE=16
ENV NODE_OPTIONS="--enable-source-maps --max-old-space-size=512"

COPY package.json package-lock.json ./
RUN npm ci --omit=dev --omit=optional && npm cache clean --force

COPY dist ./dist
COPY domains ./domains
COPY public ./public

RUN install -d -o node -g node /app/data
USER node

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://localhost:3000/health').then(r => r.ok ? process.exit(0) : process.exit(1)).catch(() => process.exit(1))"

CMD ["node", "dist/index.js"]
